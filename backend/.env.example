# SQLAlchemy connection string. A relative SQLite path is resolved from the backend/ folder.
DATABASE_URL=sqlite:///./zoom_clone.db

# Public URL of the Next.js frontend. Used to build shareable invite links (e.g. http://localhost:3000/j/85212345678).
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Seed sample data on startup when the database is empty (true/false).
SEED_ON_STARTUP=true

# --- WebRTC TURN relay (optional, but needed for calls across strict networks) ---
# Option A: Cloudflare TURN (short-lived credentials generated per request).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Option B: any TURN provider's fixed credentials (comma-separated URLs).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Option C: our own coturn (turn/Dockerfile) with time-limited credentials signed by this shared
# secret (must match the TURN service's TURN_SECRET). TURN_URLS as above.
TURN_SECRET=
